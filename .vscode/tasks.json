{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++23",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build active file with g++ on Linux"
        },
        {
            "type": "shell",
            "label": "C/C++: Build and Run",
            "command": "bash",
            "args": [
                "-c",
                "/usr/bin/g++ -fdiagnostics-color=always -g -std=c++23 \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build and run active file"
        },
        {
            "type": "shell",
            "label": "C/C++: Build all cpp files in folder",
            "command": "bash",
            "args": [
                "-c",
                "/usr/bin/g++ -fdiagnostics-color=always -g -std=c++23 ./*.cpp -o \"${fileDirname}/program\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build all .cpp files in the current directory"
        },
        {
            "type": "shell",
            "label": "C/C++: Build and Run all cpp files",
            "command": "bash",
            "args": [
                "-c",
                "/usr/bin/g++ -fdiagnostics-color=always -g -std=c++23 ./*.cpp -o \"${fileDirname}/program\" && \"${fileDirname}/program\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build all .cpp and run the program"
        }
    ]
}
